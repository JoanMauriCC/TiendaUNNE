<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <!-- Ajustar Data Source al nombre de la instancia local de SQL Server -->
    <add name="TiendaUNNE"
         providerName="System.Data.SqlClient"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=TiendaUNNE;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=15" />
  </connectionStrings>
  <appSettings>
    <!-- Carpeta donde se guardan las copias de seguridad (.bak). Tiene que ser un disco local
         y el servicio de SQL Server necesita permiso de escritura en ella. -->
    <add key="CarpetaBackups" value="C:\TiendaUNNE\Backups" />
    <!-- Asistente de ventas (Google Gemini). La CLAVE no va acá: este archivo está en GitHub.
         Va en la variable de entorno GEMINI_API_KEY de Windows (ver INSTRUCCIONES_INSTALACION.txt). -->
    <add key="GeminiModelo" value="gemini-3.6-flash" />
    <!-- Si el modelo principal está saturado o tarda, se reintenta una vez con este. -->
    <add key="GeminiModeloRespaldo" value="gemini-3.5-flash-lite" />
    <!-- Búsqueda en Google para responder sobre tendencias actuales. Solo funciona con facturación
         activada en Google AI Studio (no está en el nivel gratuito): por eso viene apagada. -->
    <add key="GeminiBuscarEnGoogle" value="false" />
  </appSettings>
</configuration>
